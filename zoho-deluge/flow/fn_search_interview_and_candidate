map fetch_links(string email_text)
{
// email_text = input.email_text.toString();
result_map = Map();
video_link = "";
script_link = "";
candidate_email = "";
// ---------------- VIDEO LINK ----------------
if(email_text.contains("https://drive.google.com/file"))
{
	start_index = email_text.indexOf("https://drive.google.com/file");
	temp = email_text.subString(start_index);
	video_link = temp.subString(0,temp.indexOf("\""));
}
// ---------------- SCRIPT LINK ----------------
if(email_text.contains("https://docs.google.com/document"))
{
	start_index = email_text.indexOf("https://docs.google.com/document");
	temp = email_text.subString(start_index);
	script_link = temp.subString(0,temp.indexOf("\""));
}
// ---------------- CANDIDATE EMAIL ----------------
if(email_text.contains("candidate:"))
{
	if(email_text.contains("mailto:"))
	{
		start_index = email_text.indexOf("mailto:") + 7;
		temp = email_text.subString(start_index);
		candidate_email = temp.subString(0,temp.indexOf("\""));
	}
}
// ---------------- CLEAN QUERY PARAMETERS ----------------
if(video_link != "" && video_link.contains("?"))
{
	video_link = video_link.subString(0,video_link.indexOf("?"));
}
if(script_link != "" && script_link.contains("?"))
{
	script_link = script_link.subString(0,script_link.indexOf("?"));
}
// ---------------- ADD TO MAP ----------------
result_map.put("Video_link",video_link);
result_map.put("Script_link",script_link);
result_map.put("candidate",candidate_email);
return result_map;
